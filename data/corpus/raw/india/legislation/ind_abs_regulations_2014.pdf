    <script type="text/javascript">
    (function () {
      function fixMiddleWidgetRow() {
        var widget = document.querySelector('.middlewidget');
        if (!widget) { return; }
        var container = widget.querySelector('.container');
        if (!container) { return; }
        var row = null, strays = [], child, i;
        for (i = 0; i < container.children.length; i++) {
          child = container.children[i];
          if (!row && child.className.indexOf('row') !== -1) {
            row = child;
          }
          else if (child.className.indexOf('col-') !== -1) {
            strays.push(child);
          }
        }
        if (!row) { return; }
        for (i = 0; i < strays.length; i++) {
          row.appendChild(strays[i]);
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fixMiddleWidgetRow);
      } else {
        fixMiddleWidgetRow();
      }
    })();
  </script>
