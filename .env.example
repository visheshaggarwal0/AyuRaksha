# AyuRaksha Environment Variables
# ----------------------------------------------------
# Neon Serverless PostgreSQL Configuration
# ----------------------------------------------------
NEON_PROJECT_ID=your_neon_project_id
NEON_ORG_ID=your_neon_org_id
NEON_BRANCH=main
NEON_HOST=your-endpoint.region.aws.neon.tech
NEON_POOLER_HOST=your-endpoint-pooler.region.aws.neon.tech
NEON_DATABASE=neondb
NEON_USER=neondb_owner
NEON_PASSWORD=your_neon_db_password_here

# Pooled connection string (For FastAPI, API requests, Serverless Functions)
DATABASE_URL=postgresql://neondb_owner:${NEON_PASSWORD}@your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct connection string (For schema migrations, DDL, vector index creation)
DIRECT_URL=postgresql://neondb_owner:${NEON_PASSWORD}@your-endpoint.region.aws.neon.tech/neondb?sslmode=require

# Optional Neon API Key (For programmatic branching & Neon CLI)
NEON_API_KEY=

# ----------------------------------------------------
# Application Configuration
# ----------------------------------------------------
APP_NAME=AyuRaksha
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=change-me-to-a-random-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ----------------------------------------------------
# AI & RAG Configuration
# ----------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------
# Digital India Bhashini Multilingual Service
# ----------------------------------------------------
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
