# AyuRaksha Environment Variables
# ----------------------------------------------------
# Neon Serverless PostgreSQL Configuration
# ----------------------------------------------------
NEON_PROJECT_ID=hidden-wind-77590258
NEON_ORG_ID=org-damp-frost-09319742
NEON_BRANCH=main
NEON_HOST=ep-hidden-wind-77590258.us-east-2.aws.neon.tech
NEON_POOLER_HOST=ep-hidden-wind-77590258-pooler.us-east-2.aws.neon.tech
NEON_DATABASE=neondb
NEON_USER=neondb_owner
NEON_PASSWORD=your_neon_db_password_here

# Pooled connection string (For FastAPI, API requests, Serverless Functions)
DATABASE_URL=postgresql://neondb_owner:${NEON_PASSWORD}@ep-hidden-wind-77590258-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct connection string (For schema migrations, DDL, vector index creation)
DIRECT_URL=postgresql://neondb_owner:${NEON_PASSWORD}@ep-hidden-wind-77590258.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional Neon API Key (For programmatic branching & Neon CLI)
NEON_API_KEY=

# ----------------------------------------------------
# Application Configuration
# ----------------------------------------------------
APP_NAME=AyuRaksha
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=ayuraksha_super_secret_production_key_change_me
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ----------------------------------------------------
# AI & RAG Configuration
# ----------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
